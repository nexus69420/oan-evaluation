# Optional overrides on top of ../.env (mock_server/.env).
# Copy to .env in this directory for beckn_search_proxy-only settings.

# PROXY_PORT=5699
# PROXY_CONFIG=/path/to/custom/config.json

# If set before starting Python, only this file is loaded (not ../.env):
# BECKN_PROXY_ENV_FILE=/path/to/custom.env

# Append each /search exchange (curl in, curl out / forwarded curl): default ./request_log.txt
# BECKN_PROXY_LOG_FILE=/path/to/request_log.txt
