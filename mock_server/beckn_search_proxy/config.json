{
  "_comment": "Paths are relative to this JSON file's directory unless absolute. Strings support ${ENV} and ${ENV:default}.",
  "upstream": {
    "base_url": "${PROXY_UPSTREAM_BASE:https://bap-client-playground-sandbox-vistaar.da.gov.in}",
    "search_path": "/search"
  },
  "rules": [
    {
      "id": "scheme_info_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "search" },
          { "path": "message.intent.category.descriptor.code", "equals": "schemes-agri" }
        ]
      },
      "then": {
        "handler": "mock_scheme_info",
        "registry": "../common_registry.json"
      }
    },
    {
      "id": "shc_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "init" },
          { "path": "message.order.provider.id", "equals": "shc-discovery" },
          {
            "type": "phone_in_registry",
            "registry": "../common_registry.json"
          }
        ]
      },
      "then": {
        "handler": "mock_shc",
        "registry": "../common_registry.json"
      }
    },
    {
      "id": "pmfby_init_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "init" },
          { "path": "message.order.provider.id", "equals": "pmfby-agri" }
        ]
      },
      "then": {
        "handler": "mock_pmfby_init",
        "registry": "../common_registry.json"
      }
    },
    {
      "id": "pmfby_grievance_init_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "init" },
          { "path": "message.order.provider.id", "equals": "pmfby-grievance" }
        ]
      },
      "then": {
        "handler": "mock_pmfby_grievance",
        "registry": "../common_registry.json"
      }
    },
    {
      "id": "pmfby_status_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "status" },
          { "path": "message.order.provider.id", "equals": "pmfby-agri" }
        ]
      },
      "then": {
        "handler": "mock_pmfby_status",
        "registry": "../common_registry.json"
      }
    },
    {
      "id": "pmkisan_init_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "init" },
          { "path": "message.order.provider.id", "equals": "" }
        ]
      },
      "then": {
        "handler": "mock_pmkisan_init",
        "registry": "../common_registry.json"
      }
    },
    {
      "id": "pmkisan_status_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "status" }
        ]
      },
      "then": {
        "handler": "mock_pmkisan_status",
        "registry": "../common_registry.json"
      }
    },
    {
      "id": "sathi_seed_availability_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "init" },
          { "path": "message.order.provider.id", "equals": "sathi-discovery" }
        ]
      },
      "then": {
        "handler": "mock_sathi",
        "registry": "../common_registry.json"
      }
    },
    {
      "id": "sathi_seed_search_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "search" },
          { "path": "message.intent.provider.id", "equals": "sathi-seed" }
        ]
      },
      "then": {
        "handler": "mock_sathi_search",
        "registry": "../common_registry.json"
      }
    },
    {
      "id": "mandi_price_metro_cities_mock",
      "when": {
        "and": [
          { "path": "context.action", "equals": "search" },
          { "path": "message.intent.category.descriptor.code", "equals": "price-discovery" },
          { "path": "message.intent.item.descriptor.code", "equals": "mandi" },
          {
            "type": "mandi_nearest_city_in",
            "registry": "../vistaar_mandi_mock/registry.json",
            "city_keys": ["kozhikode", "chandigarh", "mumbai", "kochi", "bangalore"]
          }
        ]
      },
      "then": {
        "handler": "mock_mandi",
        "registry": "../vistaar_mandi_mock/registry.json",
        "city_keys": ["kozhikode", "chandigarh", "mumbai", "kochi", "bangalore"]
      }
    }
  ]
}
