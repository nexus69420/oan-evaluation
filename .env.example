# Copy this file to .env and fill in what you need.
# Anything left unset falls back to the defaults in evaluator_alignment_prompts/config.py.

# ── API keys ──────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Input CSVs (override if you don't want them under ./data) ─────────
# TRAIN_CSV=data/train.csv
# VAL_CSV=data/val.csv
# TEST_CSV=data/test.csv

# ── CSV column names (only set these if your CSV uses different headers)
# COL_QUESTION=question
# COL_CONTEXT=context
# COL_RESPONSE=agent_response
# COL_SCORE=human_score
# COL_NOTES=human_notes
# COL_VERDICT=verdict
# COL_CONFIDENCE=confidence

# ── Score range used in your CSVs ──────────────────────────────────────
# SCORE_MIN=1
# SCORE_MAX=4

# ── Judge model (the model being calibrated) ───────────────────────────
# JUDGE_MODEL=openai/gpt-4o-mini
# JUDGE_API_BASE=                      # set for a self-hosted / vLLM endpoint
# JUDGE_API_KEY_ENV=OPENAI_API_KEY      # name of the env var holding the judge's key
# JUDGE_MAX_TOKENS=4000
# JUDGE_INPUT_COST_PER_1M=0.15
# JUDGE_OUTPUT_COST_PER_1M=0.60

# ── Prompt optimizer model (proposes rewrites, separate from the judge)
# OPTIMIZER_MODEL=openai/gpt-4o-mini
# OPTIMIZER_API_KEY_ENV=OPENAI_API_KEY

# ── Baseline prompt to start optimizing from ───────────────────────────
# BASELINE_PROMPT_PATH=prompts/evaluation_system_baseline.md

# ── Output paths ────────────────────────────────────────────────────────
# ARTIFACTS_DIR=artifacts
# OPTIMIZED_PROMPTS_DIR=optimized_prompts
# LATEST_PROMPT_PATH=optimized_prompts/latest.md
# PROMPT_REGISTRY_FILE=artifacts/prompt_registry.json

# ── Dataset caps ─────────────────────────────────────────────────────────
# MAX_TRAIN=80
# MAX_VAL=30
# MAX_TEST=30

# ── COPRO / Bootstrap / MIPRO knobs ───────────────────────────────────────
# COPRO_BREADTH=4
# COPRO_DEPTH=3
# COPRO_INIT_TEMP=0.7
# BFS_MAX_BOOTSTRAPPED=8
# BFS_MAX_LABELED=4
# MIPRO_NUM_CANDIDATES=10
# MIPRO_NUM_TRIALS=20
# MIPRO_INIT_TEMP=1.0
# NUM_THREADS=4
